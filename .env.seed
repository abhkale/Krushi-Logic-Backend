# Seeding Environment Configuration
# Copy this file to .env.seed and adjust values before running `npm run seed`

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use a separate DB for seeding/testing so production data is never touched
MONGO_URI=mongodb://localhost:27017/krushi_logic

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=krushi_seed_jwt_secret_change_me

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
