    {
      "name": "Lead Interactions",
      "description": "Record and retrieve lead interaction events.",
      "item": [
        {
          "name": "Create Lead Interaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/leads/{{leadId}}/interactions", "host": ["{{baseUrl}}"], "path": ["api", "leads", "{{leadId}}", "interactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CALL\"\n}"
            },
            "description": "Record a new interaction for a lead. Type must be one of: VIEW, CALL, WHATSAPP, MESSAGE."
          }
        },
        {
          "name": "Get Interactions for Lead",
