          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "description": "Get a specific user's profile by their MongoDB ObjectId."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rajesh_supplier_updated\",\n  \"phone\": \"9876543210\"\n}"
            },
            "description": "Update an existing user's details."
          }
        },
        {
          "name": "Get Users by Role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/role/SUPPLIER", "host": ["{{baseUrl}}"], "path": ["api", "users", "role", "SUPPLIER"] },
            "description": "Filter users by their role. Replace SUPPLIER with BUYER, FARMER, TRANSPORTER, or ADMIN."
          }
        }
      ]
    },
    {
      "name": "Products",
      "description": "Product listing management endpoints.",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "List all active product listings. Public endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const products = body.products || body.data || [];",
                  "  if (products.length > 0) pm.collectionVariables.set('productId', products[0]._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Product Listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Premium Basmati Rice – 10 MT\",\n  \"description\": \"Grade A long-grain basmati rice from Punjab\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"price\": 7800,\n  \"quantity\": 10000,\n  \"unit\": \"kg\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "description": "Create a new product listing. Requires SUPPLIER or FARMER role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const product = body.listing || body.product || body.data;",
                  "  if (product && product._id) pm.collectionVariables.set('productId', product._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "description": "Get a specific product listing by its MongoDB ObjectId."
          }
        },
        {
          "name": "Update Product Listing",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 8000,\n  \"quantity\": 9000,\n  \"status\": \"ACTIVE\"\n}"
            },
            "description": "Update an existing product listing. Only the listing owner can update."
          }
        },
        {
          "name": "Delete Product Listing",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "description": "Delete (or mark as INACTIVE) a product listing. Only the owner can delete."
          }
        },
        {
          "name": "Get Products by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/category/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "category", "{{categoryId}}"] },
            "description": "Filter product listings by category ID."
          }
        }
      ]
    },
