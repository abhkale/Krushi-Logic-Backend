{
  "info": {
    "_postman_id": "krushi-logic-backend-collection",
    "name": "Krushi Logic – Agro Marketplace API",
    "description": "Complete API collection for the Krushi Logic Agro Marketplace backend.\n\n## Setup\n1. Set the `baseUrl` variable to your server (default: http://localhost:3000)\n2. Run **POST /api/auth/login** – the `authToken` variable is set automatically.\n3. Use any protected endpoint with the token auto-injected via the collection-level pre-request script.\n\n## Default Seed Credentials\n- Email: `rajesh@example.com`  Password: `Password@123` (SUPPLIER)\n- Email: `priya@example.com`   Password: `Password@123` (BUYER)\n- Email: `admin@krushi.com`    Password: `Password@123` (ADMIN)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "leadId", "value": "", "type": "string" },
    { "key": "planId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" },
    { "key": "transportId", "value": "", "type": "string" },
    { "key": "roleId", "value": "", "type": "string" },
    { "key": "permissionId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: token is already stored in authToken variable",
          "// No extra action needed here – individual login request sets it."
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "User registration, login and logout endpoints.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_supplier\",\n  \"email\": \"test_supplier@example.com\",\n  \"phone\": \"9800000001\",\n  \"password\": \"Password@123\",\n  \"role\": \"SUPPLIER\"\n}"
            },
            "description": "Register a new user. Role must be one of: SUPPLIER, BUYER, FARMER, TRANSPORTER."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('authToken', body.token);",
                  "  if (body.user && body.user._id) pm.collectionVariables.set('userId', body.user._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "description": "Authenticate a user and receive a JWT token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('authToken', body.token);",
                  "  if (body.user && body.user._id) pm.collectionVariables.set('userId', body.user._id);",
                  "  console.log('Login successful. Token stored.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Logout the current user (invalidates the token server-side if refresh tokens are used)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('authToken', '');",
                  "  console.log('Logged out. Token cleared.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "description": "User management endpoints.",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Retrieve paginated list of all users. Requires authentication."
          }
        },
